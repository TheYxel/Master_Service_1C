Процедура ОбработкаПроведения(Отказ, Режим) 
	
	// === 1. БЛОК УПРАВЛЯЕМЫХ БЛОКИРОВОК (ОПТИМИЗИРОВАННЫЙ) ===
	Если Режим = РежимПроведенияДокумента.Оперативный Тогда
		
		// Создаем таблицу значений вместо массива
		ТолькоТовары = Новый ТаблицаЗначений;
		ТолькоТовары.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		
		Для Каждого СтрокаТЧ Из Материалы Цикл
			Если СтрокаТЧ.Номенклатура.ТипыНоменклатуры <> Перечисления.ТипыНоменклатуры.Услуга Тогда
				НоваяСтрока = ТолькоТовары.Добавить();
				НоваяСтрока.Номенклатура = СтрокаТЧ.Номенклатура;
			КонецЕсли;
		КонецЦикла;
		
		// Блокируем данные, только если в документе вообще есть хоть один физический товар
		Если ТолькоТовары.Количество() > 0 Тогда
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиМатериалов");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("Склад", Склад);
			
			// Передаем таблицу значений — этот тип платформа принимает отлично
			ЭлементБлокировки.ИсточникДанных = ТолькоТовары;
			
			// Связываем колонку нашей таблицы значений с измерением регистра
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура"); 
			
			Блокировка.Заблокировать();
			
		КонецЕсли;
		
	КонецЕсли;
	
	// === 2. ФОРМИРОВАНИЕ ДВИЖЕНИЙ ПО РЕГИСТРУ СВЕДЕНИЙ ===
	Движения.СостоянияЗаявок.Записывать = Истина;
	ДвижениеСведений = Движения.СостоянияЗаявок.Добавить();
	ДвижениеСведений.Период = Дата;
	ДвижениеСведений.Заявка = Заявка;
	ДвижениеСведений.СтатусЗаявки = Перечисления.СтатусыЗаявок.Выполнена;
	ДвижениеСведений.Исполнитель = Исполнитель; 
	
	// === 3. ФОРМИРОВАНИЕ ДВИЖЕНИЙ ПО СКЛАДУ ===
	Движения.ОстаткиМатериалов.Записывать = Истина;
	Для Каждого ТекСтрокаМатериалы Из Материалы Цикл 
		// Фильтр немат. услуги
		Если ТекСтрокаМатериалы.Номенклатура.ТипыНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
			Продолжить;
		КонецЕсли;
		
		ДвижениеСклада = Движения.ОстаткиМатериалов.Добавить();
		ДвижениеСклада.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеСклада.Период = Дата;
		ДвижениеСклада.Номенклатура = ТекСтрокаМатериалы.Номенклатура;
		ДвижениеСклада.Склад = Склад;
		ДвижениеСклада.Количество = ТекСтрокаМатериалы.Количество;
	КонецЦикла;
	
	// Склад и контроль остатков (запись для проверки «новой» методики)
	Движения.ОстаткиМатериалов.Записать(); 
	
	// === 4. ОПЕРАТИВНЫЙ КОНТРОЛЬ ОСТАТКОВ (ЗАПРОС) ===
	Если Режим = РежимПроведенияДокумента.Оперативный Тогда
		ЗапросОстатков = Новый Запрос;
		ЗапросОстатков.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиМатериаловОстатки.Номенклатура.Наименование КАК НоменклатураНаименование,
		|	-ОстаткиМатериаловОстатки.КоличествоОстаток КАК Дефицит
		|ИЗ
		|	РегистрНакопления.ОстаткиМатериалов.Остатки(&МоментВремени, Склад = &ТекущийСклад) КАК ОстаткиМатериаловОстатки
		|ГДЕ
		|	ОстаткиМатериаловОстатки.КоличествоОстаток < 0";
		
		ГраницаКонтроля = Новый Граница(МоментВремени(), ВидГраницы.Включая);
		ЗапросОстатков.УстановитьПараметр("МоментВремени", ГраницаКонтроля);
		ЗапросОстатков.УстановитьПараметр("ТекущийСклад", Склад);
		
		РезультатКонтроля = ЗапросОстатков.Выполнить(); 

			Если Не РезультатКонтроля.Пустой() Тогда
				Отказ = Истина;
				ВыборкаМинусов = РезультатКонтроля.Выбрать();
				Пока ВыборкаМинусов.Следующий() Цикл
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Недостаточно товара """ +
					ВыборкаМинусов.НоменклатураНаименование + """ на складе! Не хватает: " + ВыборкаМинусов.Дефицит + " шт.";
					Сообщение.Сообщить();
				КонецЦикла;
				
				Возврат; 
			КонецЕсли;
		КонецЕсли;
	
	// === 5. ФОРМИРОВАНИЕ ДВИЖЕНИЙ ПО ВЫРУЧКЕ ===
	Движения.ВыполненныеРаботы.Записывать = Истина;
	Для Каждого ТекСтрокаМатериалы Из  Материалы Цикл
		ДвижениеВыручки = Движения.ВыполненныеРаботы.Добавить();
		ДвижениеВыручки.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеВыручки.Период = Дата;
		ДвижениеВыручки.Клиент = Заказчик;
		ДвижениеВыручки.Исполнитель = Исполнитель;
		ДвижениеВыручки.Номенклатура = ТекСтрокаМатериалы.Номенклатура;
		ДвижениеВыручки.Количество = ТекСтрокаМатериалы.Количество;
		ДвижениеВыручки.Сумма = ТекСтрокаМатериалы.Сумма;  
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаКлиента") Тогда
	
	Отбор = Новый Структура("Заявка", ДанныеЗаполнения);
	ПоследняяЗапись = РегистрыСведений.СостоянияЗаявок.ПолучитьПоследнее(ТекущаяДата(), Отбор);
	
	СтатусОснования = Перечисления.СтатусыЗаявок.ПустаяСсылка();
	Если ПоследняяЗапись <> Неопределено Тогда
		ПоследняяЗапись.Свойство("СтатусЗаявки", СтатусОснования);
	КонецЕсли;
	
	Если СтатусОснования <> Перечисления.СтатусыЗаявок.Новая Тогда
		ВызватьИсключение "Нельзя провести документ! Статус заявки должен быть Новая";
	КонецЕсли;	
	
	
	Исполнитель = ДанныеЗаполнения.Исполнитель;
	Заказчик = ДанныеЗаполнения.Клиент;
	Комментарий = ДанныеЗаполнения.Комментарий;
	Заявка = ДанныеЗаполнения.Ссылка;
	СтатусЗаявки = ДанныеЗаполнения.СтатусЗаявки;
КонецЕсли;

КонецПроцедуры
